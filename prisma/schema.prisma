generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  role                Role     @default(USER)
  licenseKeys         LicenseKey[] @relation("activatedBy")
  recipes             Recipe[]
  mealPlan            MealPlanEntry[]
  groceryItems        GroceryListItem[]
  accounts            Account[]
  sessions            Session[]
  tokens              Int       @default(0)
  householdSize       Int       @default(1) // portions par défaut (taille du foyer)
  goal                String    @default("equilibre") // objectif nutritionnel
  validatedRecipes    String[]  // recipe IDs validées
  sharedRecipes       String[]  // recipe IDs partagées
  tokenTransactions   TokenTransaction[]
  reports             Report[]  // signalements faits par l'utilisateur
  createdAt           DateTime @default(now())
}

enum Role {
  ADMIN
  USER
}

model LicenseKey {
  id            String        @id @default(cuid())
  code          String        @unique
  durationDays  Int? // null = illimitée
  status        LicenseStatus @default(UNUSED)
  activatedAt   DateTime?
  expiresAt     DateTime?
  activatedById String?
  activatedBy   User?         @relation("activatedBy", fields: [activatedById], references: [id])
  createdAt     DateTime      @default(now())
}

enum LicenseStatus {
  UNUSED
  ACTIVE
  REVOKED
}

model Recipe {
  id              String          @id @default(cuid())
  title           String
  servings        Int             @default(2)
  minutes         Int?
  tags            String[]
  ingredients     Json // [{ nom: string, quantite?: number, unite?: string }]
  steps           String[]
  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id])
  categorieId     String?
  categorie       Categorie?      @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  entries         MealPlanEntry[]
  isPublic        Boolean         @default(false)
  publishedAt     DateTime?
  validatedAt     DateTime?
  boostedUntil    DateTime?
  validationCount Int             @default(0)
  validators      String[]        // user IDs ayant validé
  sharedWith      String[]        // user IDs ayant ajouté à leurs recettes
  isSharedCopy    Boolean         @default(false)
  sourceRecipeId  String?
  editable        Boolean         @default(true)
  reports         Report[]
  createdAt       DateTime        @default(now())

  @@index([categorieId])
}

model Categorie {
  id        String   @id @default(cuid())
  nom       String
  cle       String   @unique
  masquee   Boolean  @default(false)
  createdAt DateTime @default(now())
  recettes  Recipe[]
}

model MealPlanEntry {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  slot     MealSlot
  servings Int      @default(2)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order    Int      @default(0)

  @@unique([ownerId, date, slot, order])
}

enum MealSlot {
  PETIT_DEJEUNER
  DEJEUNER
  DINER
}

model GroceryListItem {
  id        String   @id @default(cuid())
  nom       String
  quantite  Float?
  unite     String?
  rayon     String
  checked   Boolean  @default(false)
  source    GroceryItemSource @default(PLAN)
  masquee   Boolean  @default(false)
  weekStart DateTime @db.Date
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, weekStart, nom, unite])
}

enum GroceryItemSource {
  PLAN
  MANUEL
}

model Report {
  id        String       @id @default(cuid())
  recipeId  String
  recipe    Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reporterId String
  reporter  User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason    String       // "spam" | "inapproprié" | "autre"
  detail    String?
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
}

model TokenTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int      // +1 pour validation, -X pour achats futurs
  reason    String   // "validation" | "achat" | "bonus"
  recipeId  String?  // recette concernée
  createdAt DateTime @default(now())
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// Modèles standards de l'adaptateur Auth.js (@auth/prisma-adapter)

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
